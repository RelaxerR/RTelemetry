{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RTelemetry": {
    "DataDirectory": "data",
    "Projects": {},
    "Dashboard": {
      "User": "",
      "Password": ""
    },
    "Storage": {
      "Provider": "JsonLines",
      "ConnectionString": ""
    },
    "RetentionDays": 90,
    "AdminKey": "",
    "RateLimit": {
      "RequestsPerMinutePerIp": 120,
      "RequestsPerMinutePerProject": 600
    }
  }
}
