<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Сервер RTelemetry: приём пачек (POST /v1/batches) и простой фронт статистики (Razor Pages).
    Хранилище PostgreSQL для production или JSON Lines для разработки, см. docs/server.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <ProjectReference Include="../RTelemetry.Contracts/RTelemetry.Contracts.csproj" />
  </ItemGroup>

</Project>
