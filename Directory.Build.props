<Project>

  <!--
    Общие свойства всех проектов RTelemetry. Версия пакетов одна на весь репозиторий
    и меняется по SemVer (см. docs/integration.md, раздел «Версии»).
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>telemetry;analytics;privacy;maui</PackageTags>
    <Authors>RelaxerR (Vyacheslav Kiselev)</Authors>
    <Company>RelaxerR Games</Company>
    <Product>RTelemetry</Product>
    <PackageProjectUrl>https://github.com/RelaxerR/RTelemetry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RelaxerR/RTelemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Отладка исходников пакета из потребителя (SourceLink встроен в SDK 8+). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
